{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for the main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "dialog:allow-open",
    "dialog:allow-ask",
    "dialog:allow-message",
    "dialog:allow-save",
    "core:window:allow-destroy"
  ]
}
